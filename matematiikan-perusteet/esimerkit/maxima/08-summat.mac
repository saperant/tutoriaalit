/* Jonot ja summat Maximalla. */
display2d: false$
simpsum: true$

/* @alku summat */
print("1 + ... + n =", factor(sum(k, k, 1, n)))$
print("1^2 + ... + n^2 =", factor(sum(k^2, k, 1, n)))$
print("1^3 + ... + n^3 =", factor(sum(k^3, k, 1, n)))$
print("geometrinen:", ratsimp(sum(q^(k - 1), k, 1, n)))$
print("aareton:", sum((1/2)^k, k, 0, inf))$
/* @loppu summat */

/* @alku induktio */
F(n) := (n*(n + 1)/2)^2$
print("perusaskel:", is(F(1) = 1))$
print("askel:", ratsimp(F(n) + (n + 1)^3 - F(n + 1)))$
/* @loppu induktio */

/* @alku korko */
print("5000 * 1.03^10 =", float(5000*(103/100)^10))$
/* @loppu korko */
