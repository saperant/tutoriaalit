digraph {
  rankdir=LR; nodesep=0.4; ranksep=0.6;
  edge [fontsize=8];
  node [shape=circle, width=0.4, fixedsize=true];
  subgraph cluster_S { label="S"; color="#D9E0E3"; A; C; }
  subgraph cluster_T { label="T"; color="#D9E0E3"; B; D; E; F; }
  A -> B [label="10/10", color="#B04848", penwidth=1.6];
  A -> C [label="9/10"];
  B -> C [label="0/2", style=dashed];
  B -> D [label="4/4"];
  B -> E [label="6/8"];
  C -> E [label="9/9", color="#B04848", penwidth=1.6];
  E -> D [label="5/6"];
  D -> F [label="9/10"];
  E -> F [label="10/10"];
}
