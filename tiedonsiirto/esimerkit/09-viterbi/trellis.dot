digraph trellis {
  rankdir=LR; ranksep=2.2; nodesep=0.45; splines=line;
  node [shape=circle, fixedsize=true, width=0.45];
  a0 [label="00"]; b0 [label="00"];
  a1 [label="01"]; b1 [label="01"];
  a2 [label="10"]; b2 [label="10"];
  a3 [label="11"]; b3 [label="11"];
  a0 -> a1 [style=invis];
  b0 -> b1 [style=invis];
  a1 -> a2 [style=invis];
  b1 -> b2 [style=invis];
  a2 -> a3 [style=invis];
  b2 -> b3 [style=invis];
  a0 -> b0 [taillabel="00", labeldistance=2.6, labelangle=14];
  a0 -> b2 [taillabel="11", labeldistance=2.6, labelangle=-14, style=dashed];
  a1 -> b0 [taillabel="11", labeldistance=2.6, labelangle=14];
  a1 -> b2 [taillabel="00", labeldistance=2.6, labelangle=-14, style=dashed];
  a2 -> b1 [taillabel="10", labeldistance=2.6, labelangle=14];
  a2 -> b3 [taillabel="01", labeldistance=2.6, labelangle=-14, style=dashed];
  a3 -> b1 [taillabel="01", labeldistance=2.6, labelangle=14];
  a3 -> b3 [taillabel="10", labeldistance=2.6, labelangle=-14, style=dashed];
  { rank=same; a0; a1; a2; a3; }
  { rank=same; b0; b1; b2; b3; }
}
