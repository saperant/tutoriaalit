    n9 [label="*"];
    n10 [label="2", fillcolor="#FFFFFF"];
    n9 -> n10;
    n11 [label="x", fillcolor="#FFFFFF"];
    n9 -> n11;
    n8 -> n9;
    n12 [label="+"];
