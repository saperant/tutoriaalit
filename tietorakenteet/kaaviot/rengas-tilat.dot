  l1 [label="luku", fontsize=9]; k1 [label="kirjoitus", fontsize=9];
  l1 -> t1:p5; k1 -> t1:p3;
  t0 -> l1 [style=invis];
  t2 [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td border="0" align="right">täysi  </td><td port="p0" width="24" bgcolor="#D8EFEB">1</td><td port="p1" width="24" bgcolor="#D8EFEB">9</td><td port="p2" width="24" bgcolor="#D8EFEB">2</td><td port="p3" width="24" bgcolor="#D8EFEB">.</td><td port="p4" width="24" bgcolor="#D8EFEB">0</td><td port="p5" width="24" bgcolor="#D8EFEB">.</td><td port="p6" width="24" bgcolor="#D8EFEB">2</td><td port="p7" width="24" bgcolor="#D8EFEB">␣</td></tr><tr><td border="0"></td><td border="0"><font point-size="8">0</font></td><td border="0"><font point-size="8">1</font></td><td border="0"><font point-size="8">2</font></td><td border="0"><font point-size="8">3</font></td><td border="0"><font point-size="8">4</font></td><td border="0"><font point-size="8">5</font></td><td border="0"><font point-size="8">6</font></td><td border="0"><font point-size="8">7</font></td></tr></table>>];
