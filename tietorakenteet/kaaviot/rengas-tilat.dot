digraph {
  rankdir=TB; nodesep=0.3; ranksep=0.25;
  node [shape=plain, style=solid]; edge [arrowsize=0.6];
  t0 [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td border="0" align="right">tyhjä  </td><td port="p0" width="24"> </td><td port="p1" width="24"> </td><td port="p2" width="24"> </td><td port="p3" width="24"> </td><td port="p4" width="24"> </td><td port="p5" width="24"> </td><td port="p6" width="24"> </td><td port="p7" width="24"> </td></tr><tr><td border="0"></td><td border="0"><font point-size="8">0</font></td><td border="0"><font point-size="8">1</font></td><td border="0"><font point-size="8">2</font></td><td border="0"><font point-size="8">3</font></td><td border="0"><font point-size="8">4</font></td><td border="0"><font point-size="8">5</font></td><td border="0"><font point-size="8">6</font></td><td border="0"><font point-size="8">7</font></td></tr></table>>];
  i0 [label="luku = kirjoitus (täyttö 0)", fontsize=9];
  i0 -> t0:p3;
