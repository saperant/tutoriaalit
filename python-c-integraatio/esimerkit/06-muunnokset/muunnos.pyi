from collections.abc import Iterable, Iterator
from typing import ClassVar

class Laskurit:
    def __init__(self, arvot: Iterable[int] = ...) -> None: ...
    def __iter__(self) -> Iterator[int]: ...
    def __len__(self) -> int: ...

def tuplaa(arvot: list[float]) -> None: ...
def kasvata(laskurit: Laskurit) -> None: ...

class Vahvistus:
    elossa: ClassVar[int]
    def __init__(self, kerroin: float) -> None: ...
    def kasittele(self, x: float) -> float: ...

class Ketju:
    def __init__(self) -> None: ...
    def lisaa(self, v: Vahvistus) -> None: ...
    def aja(self, x: float) -> float: ...
    def vaihe(self, i: int) -> Vahvistus: ...
