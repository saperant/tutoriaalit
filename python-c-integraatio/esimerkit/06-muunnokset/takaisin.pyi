from collections.abc import Callable

class Halytin:
    def __init__(self, raja: float) -> None: ...
    def kun_ylittyy(self, kasittelija: Callable[[float], None]) -> None: ...
    def syota(self, arvot: list[float]) -> int: ...

class Suodin:
    def __init__(self) -> None: ...
    def kasittele(self, x: float) -> float: ...

def summa_suodatettuna(suodin: Suodin, arvot: list[float]) -> float: ...
