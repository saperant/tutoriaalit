digraph vuo {
  rankdir=LR;
  node [fontsize=10];
  "lokit/sim.log" [shape=ellipse, fontsize=9];
  "obj/sim" [shape=ellipse, fontsize=9];
  "rtl/alu.sv" [shape=ellipse, fontsize=9];
  "rtl/laskuri.sv" [shape=ellipse, fontsize=9];
  "sta.txt" [shape=ellipse, fontsize=9];
  "synteesi/laskuri_8.blif" [shape=ellipse, fontsize=9];
  "synteesi/stat_8.json" [shape=ellipse, fontsize=9];
  "tb/alu_tb.sv" [shape=ellipse, fontsize=9];
  "tcl/opetus_sta.tcl" [shape=ellipse, fontsize=9];
  "tcl/sta_kulku.tcl" [shape=ellipse, fontsize=9];
  "tcl/synteesi.tcl" [shape=ellipse, fontsize=9];
  "lint" [shape=box];
  "rtl/laskuri.sv" -> "lint";
  "synteesi" [shape=box];
  "rtl/laskuri.sv" -> "synteesi";
  "tcl/synteesi.tcl" -> "synteesi";
  "synteesi" -> "synteesi/stat_8.json";
  "synteesi" -> "synteesi/laskuri_8.blif";
  "lint" -> "synteesi" [style=dashed];
  "sta" [shape=box];
  "synteesi/laskuri_8.blif" -> "sta";
  "tcl/opetus_sta.tcl" -> "sta";
  "tcl/sta_kulku.tcl" -> "sta";
  "sta" -> "sta.txt";
  "kaannos" [shape=box];
  "rtl/alu.sv" -> "kaannos";
  "tb/alu_tb.sv" -> "kaannos";
  "kaannos" -> "obj/sim";
  "sim" [shape=box];
  "obj/sim" -> "sim";
  "sim" -> "lokit/sim.log";
}
digraph katkaisu {
  rankdir=LR;
  node [fontsize=10];
  "lokit/sim.log" [shape=ellipse, fontsize=9];
  "obj/sim" [shape=ellipse, fontsize=9];
  "rtl/alu.sv" [shape=ellipse, fontsize=9];
