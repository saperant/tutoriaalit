# SymbiYosysin tehtävätiedosto FIFOn tarkistukseen (luku 8).
# Ajo: sby -f fifo.sby   (ajaa tehtävät bmc, prove ja cover)
#
# Ubuntun paketeissa ei ole SymbiYosysia, joten tämän kirjan esimerkit
# tekevät saman suoraan Yosysilla ja yosys-smtbmc:llä
# (tyokalut/formaali.py). Tiedosto näyttää, miltä sama näyttää sby:llä.

[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 10
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 10

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -DINVARIANTTI fifo.sv
prep -top fifo

[files]
../rtl/fifo.sv
