// lahde: rtl/fir_jaettu.sv rtl/kavenna.sv
// vcd: --kello clk --signaalit s_valid,s_ready,nayte,vaihe,m_valid,m_ready,tulos --alku 1 --jaksot 24 --kanta d --naytteistys ennen
// Aikamultipleksoitu FIR: näyte otetaan vastaan vain levossa, ja
// vastaanottaja pitää m_readyn alhaalla muutaman jakson (vastapaine).
// Arvot näytetään juuri ennen kellon nousevaa reunaa, jolloin jakson
// syötteet ja rekisterien arvot ovat asettuneet. Kaaviossa näkyy
// datan sijaan näytteen ja tuloksen järjestysnumero (kättely on tässä
// olennainen, ja etumerkilliset arvot näkyisivät VCD:stä etumerkittöminä).
module kaavio;
  logic clk = 1'b0, nollaus = 1'b1, s_valid = 1'b0, m_ready = 1'b1;
  logic signed [11:0] s_data = '0;
  wire s_ready, m_valid;
  wire signed [11:0] m_data;
  wire [2:0] vaihe = dut.vaihe;
  logic [3:0] nayte = 4'd1, tulos = 4'd0;
  fir_jaettu dut (.*);
  always #5 clk = ~clk;
  always @(posedge clk) begin
    if (s_valid && s_ready) nayte <= nayte + 4'd1;
    if (m_valid && m_ready) tulos <= tulos + 4'd1;
  end
  initial begin
    $dumpfile("kaavio.vcd");
    $dumpvars(1, kaavio);
    repeat (2) @(posedge clk);
    nollaus <= 1'b0;
    s_valid <= 1'b1;
    s_data  <= 12'sd1000;
    @(posedge clk iff s_ready);
    s_data  <= 12'sd500;
    // Vastaanottaja ei ole valmis, kun toinen tulos valmistuu.
    repeat (8) @(posedge clk);
    m_ready <= 1'b0;
    repeat (4) @(posedge clk);
    m_ready <= 1'b1;
    repeat (8) @(posedge clk);
    $finish;
  end
endmodule
