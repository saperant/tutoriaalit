#version 460
// Summa atomisella lisäyksellä: jokainen säie lisää oman alkionsa
// yhteen muistipaikkaan. Oikein mutta sarjallistuu.

// @alku atomi
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Syote { uint x[]; };
layout(set = 0, binding = 1) buffer Summa { uint summa; };
layout(push_constant) uniform Vakiot { uint n; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        atomicAdd(summa, x[i]);
    }
}
// @loppu atomi
