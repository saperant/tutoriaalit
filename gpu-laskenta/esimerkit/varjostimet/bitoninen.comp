#version 460
// Bitonisen lajitteluverkon yksi askel globaalissa muistissa: alkio i
// verrataan alkioon i ^ j, ja suunta riippuu bitistä k. Isäntä ajaa
// tämän jokaiselle parille (k, j), ja ajojen välissä on este.

// @alku askel
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer Data { uint a[]; };
layout(push_constant) uniform Vakiot { uint k; uint j; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint pari = i ^ j;
    if (pari > i) {  // kumpikin pari käsitellään kerran
        const bool nouseva = (i & k) == 0;
        const uint x = a[i];
        const uint y = a[pari];
        if ((x > y) == nouseva) {
            a[i] = y;
            a[pari] = x;
        }
    }
}
// @loppu askel
