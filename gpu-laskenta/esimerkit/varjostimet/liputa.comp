#version 460
// Liput virran tiivistykseen: 1, jos alkio on jaollinen jakajalla.

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Syote { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Liput { uint liput[]; };
layout(push_constant) uniform Vakiot { uint n; uint jakaja; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        liput[i] = x[i] % jakaja == 0 ? 1 : 0;
    }
}
