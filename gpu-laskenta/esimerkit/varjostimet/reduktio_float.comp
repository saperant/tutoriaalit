#version 460
// Liukulukusumma samalla puulla kuin reduktio_jaettu.comp.

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Syote { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Osat { float osat[]; };
layout(push_constant) uniform Vakiot { uint n; };

shared float valisummat[256];

void main() {
    const uint oma = gl_LocalInvocationID.x;
    const uint i = gl_WorkGroupID.x * 512 + oma;
    const float a = i < n ? x[i] : 0.0;
    const float b = i + 256 < n ? x[i + 256] : 0.0;
    valisummat[oma] = a + b;
    barrier();
    for (uint askel = 128; askel > 0; askel /= 2) {
        if (oma < askel) {
            valisummat[oma] += valisummat[oma + askel];
        }
        barrier();
    }
    if (oma == 0) {
        osat[gl_WorkGroupID.x] = valisummat[0];
    }
}
