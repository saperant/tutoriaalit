#version 460
// Täyttää puskurin vakiolla.

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) writeonly buffer Kohde { float kohde[]; };
layout(push_constant) uniform Vakiot { uint n; float arvo; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        kohde[i] = arvo;
    }
}
