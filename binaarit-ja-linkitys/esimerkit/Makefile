# Objektitiedostojen ja linkityksen esimerkit.
#
#   make         rakentaa, ajaa ja tarkistaa kaikki esimerkit
#   make siivoa  poistaa build/-hakemiston
#
# Jokainen esimerkki on hakemisto NN-nimi/, jonka aja.sh rakentaa
# ohjelmat ja tulostaa tarkistettavat asiat. Tulostetta verrataan
# tiedostoon odotettu. Ks. testaa.sh.

.PHONY: kaikki siivoa

kaikki:
	./testaa.sh

siivoa:
	rm -rf build
