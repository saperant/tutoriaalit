== 1. esikäsittely (cpp): makrot auki, kommentit pois
int pinta_ala(int sivu)
{
    return sivu > 100 ? -1 : ((sivu) * (sivu));
}
== 2. käännös assemblyksi (-S): funktion käskyt
pinta_ala:
.LFB0:
        endbr64
        movl    %edi, %eax
        cmpl    $100, %edi
        jg      .L3
        imull   %edi, %eax
        ret
.L3:
        movl    $-1, %eax
        ret
.LFE0:
