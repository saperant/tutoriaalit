fn main()
L0:
    i.0 = 1
    i.1 = i.0
    jmp L1
L1:                      ; edeltäjät: L0 L3
    %1 = 1
    i.2 = add i.1, %1
    %2 = 5
    %3 = lt i.2, %2
    br %3, L3, L2
L2:                      ; edeltäjät: L1
    print i.1
    %4 = 0
    ret %4
L3:                      ; edeltäjät: L1
    i.1 = i.2
    jmp L1
