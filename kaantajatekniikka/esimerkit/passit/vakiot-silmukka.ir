; passit: vakiot
; askel saa silmukassa uuden arvon vain, jos se ei ole 1.
fn f(n)
L0:
    askel.0 = 1
    i.0 = 0
    jmp L1
L1:
    askel.1 = phi [askel.0, L0], [askel.3, L4]
    i.1 = phi [i.0, L0], [i.2, L4]
    %1 = lt i.1, n
    br %1, L2, L5
L2:
    %2 = 1
    %3 = ne askel.1, %2
    br %3, L3, L4
L3:
    askel.2 = 2
    jmp L4
L4:
    askel.3 = phi [askel.1, L2], [askel.2, L3]
    i.2 = add i.1, askel.3
    jmp L1
L5:
    ret i.1
