fn main()
L0:
    a.0 = 1
    b.0 = 2
    i.0 = 0
    a.1 = a.0
    b.1 = b.0
    i.1 = i.0
    jmp L1
L1:                      ; edeltäjät: L0 L2
    %1 = 3
    %2 = lt i.1, %1
    br %2, L2, L3
L2:                      ; edeltäjät: L1
    %3 = 1
    i.2 = add i.1, %3
    i.1 = i.2
    %k11 = a.1
    a.1 = b.1
    b.1 = %k11
    jmp L1
L3:                      ; edeltäjät: L1
    print a.1
    print b.1
    %4 = 0
    ret %4
