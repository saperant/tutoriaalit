; passit: kaaret,pura-naiivi
; Silmukka vaihtaa a:n ja b:n keskenään kolme kertaa.
fn main()
L0:
    a.0 = 1
    b.0 = 2
    i.0 = 0
    jmp L1
L1:
    a.1 = phi [a.0, L0], [b.1, L2]
    b.1 = phi [b.0, L0], [a.1, L2]
    i.1 = phi [i.0, L0], [i.2, L2]
    %1 = 3
    %2 = lt i.1, %1
    br %2, L2, L3
L2:
    %3 = 1
    i.2 = add i.1, %3
    jmp L1
L3:
    print a.1
    print b.1
    %4 = 0
    ret %4
