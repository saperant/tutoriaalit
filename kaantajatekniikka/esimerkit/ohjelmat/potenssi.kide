// Potenssi modulo m neliöön korottamalla: O(log e) kertolaskua.
fn potenssi(kanta: int, e: int, m: int) -> int {
    var tulos = 1;
    kanta = kanta % m;
    while e > 0 {
        if e % 2 == 1 {
            tulos = tulos * kanta % m;
        }
        kanta = kanta * kanta % m;
        e = e / 2;
    }
    return tulos;
}

fn main() -> int {
    print(potenssi(2, 10, 1000000007));
    print(potenssi(3, 200, 1000000007));
    print(potenssi(7, 1000000006, 1000000007));   // Fermat: 1
    return 0;
}
