// Fibonaccin luvut kahdella tavalla: eksponentiaalinen rekursio ja
// lineaarinen silmukka. Molempien on annettava sama tulos.
fn fib_rekursio(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib_rekursio(n - 1) + fib_rekursio(n - 2);
}

fn fib_silmukka(n: int) -> int {
    var a = 0;
    var b = 1;
    while n > 0 {
        var seuraava = a + b;
        a = b;
        b = seuraava;
        n = n - 1;
    }
    return a;
}

fn main() -> int {
    var i = 0;
    while i <= 20 {
        if fib_rekursio(i) != fib_silmukka(i) {
            print(-1);
            return 1;
        }
        i = i + 5;
    }
    print(fib_rekursio(20));
    print(fib_silmukka(90));
    return 0;
}
