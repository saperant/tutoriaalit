# Ajurikehityksen lisäykset perus.config-fragmenttiin (embedded-linux).
# Lisätään tinyconfigin päälle perus.configin jälkeen.

# @alku vianetsinta
# Symbolinimet kaatumisilmoituksiin, BUG()- ja WARN()-tarkistukset.
CONFIG_KALLSYMS=y
CONFIG_BUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
# Nukkuminen atomisessa kontekstissa ja lukkojärjestys (lockdep).
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_LOCKING=y
# @loppu vianetsinta

# @alku vaylat
# I2C-ydin, käyttäjätilan /dev/i2c-N ja testiväylä i2c-stub.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_STUB=m
# Ytimen oma LM75-ajuri vertailukohdaksi (tuo mukanaan regmap-i2c:n).
CONFIG_HWMON=y
CONFIG_SENSORS_LM75=y
# SPI-ydin; ohjain on tämän tutoriaalin oma ohjelmallinen ohjain.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
# @loppu vaylat

# @alku virta
# Virranhallinnan ydin: ajonaikainen (runtime PM) ja järjestelmän
# lepotila. PM_DEBUG tuo tiedoston /sys/power/pm_test, jolla lepotilan
# vaiheet voi ajaa ilman herätyslähdettä, ja PM_ADVANCED_DEBUG laitteen
# käyttölaskurin sysfsiin.
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
# Säädinkehys ja laitepuun kiinteä säädin (regulator-fixed).
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# GPIO-kehys ja simuloitu GPIO-ohjain testilinjoiksi.
CONFIG_GPIOLIB=y
CONFIG_GPIO_SIM=y
# @loppu virta
