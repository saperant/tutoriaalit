# Pienen ARM64-ytimen konfiguraatiofragmentti QEMU:n virt-koneelle.
# Lisätään tinyconfigin päälle: make tinyconfig + merge_config.sh.

# @alku konsoli
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# @loppu konsoli

# @alku kaynnistys
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# @loppu kaynnistys

# glibc:n staattiset ohjelmat tarvitsevat nämä järjestelmäkutsut.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_EPOLL=y

# @alku levy
CONFIG_BLOCK=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
# @loppu levy

# @alku moduulit
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# @loppu moduulit

# @alku tunniste
CONFIG_LOCALVERSION="-tutoriaali"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# @loppu tunniste
