# BusyBox-initin /etc/inittab (muoto: tunniste:ajotasot:toiminto:komento).
# BusyBox ei käytä tunniste- eikä ajotasokenttiä.
::sysinit:/bin/mount -a
::sysinit:/etc/init.d/rcS
::respawn:/sbin/palvelu lampo kaatuva 2
ttyAMA0::respawn:/sbin/getty -L 115200 ttyAMA0 vt100
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
