# systemd-yksikkö samalle palvelulle (/etc/systemd/system/lampo.service).
# Type=notify odottaa palvelun sd_notify("READY=1") -ilmoitusta.
[Unit]
Description=Lampoanturin lukija
After=loki.service
Requires=loki.service
StartLimitIntervalSec=10s
StartLimitBurst=3

[Service]
Type=notify
ExecStart=/sbin/palvelu lampo kaatuva 2
Restart=on-failure
RestartSec=200ms
TimeoutStopSec=1s

[Install]
WantedBy=multi-user.target
