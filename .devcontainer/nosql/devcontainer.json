{
  "name": "NoSQL-tietokannat: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "PIP_PAKETIT": "testcontainers==4.15.0 redis==8.2.0 pymongo==4.20.1 cassandra-driver==3.30.1 neo4j==6.4.1 psycopg==3.3.9 psycopg-binary==3.3.9 ruff mypy pytest"
    }
  },
  "runArgs": [
    "-v=/var/run/docker.sock:/var/run/docker.sock",
    "--add-host=host.docker.internal:host-gateway",
    "-e=DOCKER_HOST=unix:///var/run/docker.sock",
    "-e=TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal",
    "-e=TESTCONTAINERS_CONNECTION_MODE=docker_host"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/nosql/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
