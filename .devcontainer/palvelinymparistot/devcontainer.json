{
  "name": "Palvelinympäristöt: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "shellcheck rsync restic slapd ldap-utils e2fsprogs systemd",
      "PIP_PAKETIT": "ansible-core==2.21.6 ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/palvelinymparistot/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "timonwong.shellcheck"
      ]
    }
  }
}
