{
  "name": "Käännösjärjestelmät, testaus ja CI: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "cmake ninja-build pkgconf gcovr clang-tidy-20 cppcheck shellcheck python3-yaml",
      "PIP_PAKETIT": "check-jsonschema==0.39.0"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/rakennus-ja-testaus/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "make -s -j4"
}
