{
  "name": "SoC-integraatio: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator gcc-riscv64-unknown-elf",
      "PIP_PAKETIT": "ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/soc-integraatio/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "ms-vscode.cpptools"
      ]
    }
  }
}
