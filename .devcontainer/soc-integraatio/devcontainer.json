{
  "name": "SoC-integraatio: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator iverilog gcc-riscv64-unknown-elf",
      "PIP_PAKETIT": "cocotb==2.1.0 ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/soc-integraatio/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "ms-vscode.cpptools"
      ]
    }
  }
}
