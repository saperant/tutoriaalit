{
  "name": "Python ja C/C++ yhteen: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "python3-dev cmake",
      "PIP_PAKETIT": "pybind11==3.1.0 nanobind==3.1.0 numpy setuptools>=77 wheel ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/python-c-integraatio/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}
