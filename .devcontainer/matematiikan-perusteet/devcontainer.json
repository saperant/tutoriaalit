{
  "name": "Matematiikan perusteet ohjelmallisesti: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "maxima",
      "PIP_PAKETIT": "sympy==1.14.0 numpy matplotlib ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/matematiikan-perusteet/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
