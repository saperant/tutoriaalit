{
  "name": "Jatkuva integraatio ja toimitus: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "git",
      "PIP_PAKETIT": "ruff mypy pytest matplotlib yamllint==1.38.0 check-jsonschema==0.39.0"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/jatkuva-toimitus/esimerkit",
  "customizations": {
