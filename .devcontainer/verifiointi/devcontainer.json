{
  "name": "Laitteiston verifiointi: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator iverilog yosys z3 boolector",
      "PIP_PAKETIT": "cocotb ruff mypy pytest"
