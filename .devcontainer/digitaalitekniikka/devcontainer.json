{
  "name": "Digitaalitekniikka: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator",
      "PIP_PAKETIT": "ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/digitaalitekniikka/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "ms-python.python"
      ]
    }
  }
}
