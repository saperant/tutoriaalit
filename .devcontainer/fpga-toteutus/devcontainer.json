{
  "name": "FPGA-toteutus: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "yosys nextpnr-ice40 fpga-icestorm verilator iverilog graphviz fonts-inter fonts-dejavu-core",
      "PIP_PAKETIT": "ruff mypy matplotlib"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/fpga-toteutus/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl"
      ]
    }
  }
}
