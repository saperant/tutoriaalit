{
  "name": "Verkkoinfrastruktuuri: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "iproute2 iputils-ping tcpdump nftables dnsmasq frr wireguard-tools bridge-utils curl"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/verkkoinfrastruktuuri/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "timonwong.shellcheck"
      ]
    }
  }
}
