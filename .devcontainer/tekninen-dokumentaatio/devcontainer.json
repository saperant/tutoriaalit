{
  "name": "Tekninen dokumentaatio: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "doxygen graphviz",
      "PIP_PAKETIT": "sphinx==8.2.3 mkdocs==1.6.1 openapi-spec-validator==0.9.0 jsonschema==4.26.0 pyyaml types-PyYAML ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tekninen-dokumentaatio/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "lextudio.restructuredtext"
      ]
    }
  }
}
