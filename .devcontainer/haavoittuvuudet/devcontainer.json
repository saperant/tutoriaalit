{
  "name": "Haavoittuvuuksien analyysi ja torjunta: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "gdb strace binutils shellcheck clang-tidy-20 lld-20 afl++ gcc-aarch64-linux-gnu",
      "PIP_PAKETIT": "ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/haavoittuvuudet/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  }
}
