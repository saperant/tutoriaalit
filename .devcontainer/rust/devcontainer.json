{
  "name": "Rust: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "rustc-1.80 cargo-1.80 rust-1.80-clippy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/rust/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
