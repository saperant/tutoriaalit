{
  "name": "Laitteiston kuvausstandardit (SystemRDL, IP-XACT): esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator libxml2-utils device-tree-compiler tcl8.6",
      "PIP_PAKETIT": "systemrdl-compiler==1.33.0 peakrdl==1.5.0 peakrdl-regblock==1.3.1 peakrdl-cheader==1.2.0 peakrdl-uvm==2.4.0 peakrdl-ipxact==3.5.0 ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/kuvausstandardit/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mshr-h.veriloghdl"
      ]
    }
  }
}
