{
  "name": "DSP-algoritmien laitteistototeutus: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator iverilog yosys nextpnr-ice40 shellcheck",
      "PIP_PAKETIT": "cocotb==2.1.0 numpy matplotlib scipy==1.18.1 scipy-stubs==1.18.1.1 ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/dsp-laitteisto/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mshr-h.veriloghdl"
      ]
    }
  }
}
