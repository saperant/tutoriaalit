{
  "name": "Laiteohjelmiston takaisinmallinnus: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "gcc-arm-none-eabi libnewlib-arm-none-eabi qemu-system-arm gdb-multiarch radare2 binutils shellcheck",
      "PIP_PAKETIT": "unicorn==2.1.4 capstone==5.0.9 ruff mypy"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/laiteohjelmiston-takaisinmallinnus/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  }
}
