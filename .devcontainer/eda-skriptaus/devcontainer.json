{
  "name": "EDA-skriptaus: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "verilator yosys iverilog tcl8.6",
      "PIP_PAKETIT": "ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/eda-skriptaus/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mshr-h.veriloghdl"
      ]
    }
  }
}
