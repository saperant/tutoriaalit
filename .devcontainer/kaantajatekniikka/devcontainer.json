{
  "name": "Kääntäjätekniikka: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "gcc-riscv64-linux-gnu libc6-dev-riscv64-cross qemu-user binutils"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/kaantajatekniikka/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ]
    }
  }
}
