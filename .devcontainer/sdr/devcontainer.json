{
  "name": "Ohjelmistoradio: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "gnuradio",
      "PIP_PAKETIT": "--ignore-installed numpy scipy==1.18.1 scipy-stubs==1.18.1.1 matplotlib ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/sdr/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}
