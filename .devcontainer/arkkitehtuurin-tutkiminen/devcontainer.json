{
  "name": "Arkkitehtuurin mallinnus ja suunnittelutilan tutkiminen: esimerkit",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "LISAPAKETIT": "libsystemc-dev pkgconf shellcheck",
      "PIP_PAKETIT": "numpy matplotlib ruff mypy pytest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/arkkitehtuurin-tutkiminen/esimerkit",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}
